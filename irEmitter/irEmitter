//battery 
const float ADC_REF = 3.3;
const float R1 = 100000.0;
const float R2 = 100000.0;
const float low_batt_voltage = 2.4;

float readBatteryVoltage(){
  int raw = analogRead(batteryPin);
  float v = (raw / 4095.0) * ADC_REF;
  return v * ((R1+R2) / R2);
}

void flashLowBattery(){
  pinMode(LED_BUILTIN, OUTPUT);
  for(int i=0; i<3; i++){
    digitalWrite(LED_BUILTIN, HIGH);
    delay(150);
    digitalWrite(LED_BUILTIN, LOW);
    delay(150);
  }
}

void setup() {
  WiFi.mode(WIFI_OFF);
  btStop();

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(IR_LED_PIN, OUTPUT);

  Serial.begin(115200);
  irsend.begin();
  pinMode(kButtonPin, INPUT_PULLUP);  // Button uses internal pull-up
  Serial.println("Ready! Press button to send IR signals.");
}

void loop() {
  bool buttonState = digitalRead(kButtonPin);

  // Detect falling edge (button press)
  if (lastButtonState == HIGH && buttonState == LOW) {
    Serial.println("Button pressed! Sending IR signals...");
    
    //test tv power
    //irsend.sendJVC(jvcTestTvCode);
    // Send Yamaha soundbar power
    //irsend.sendRaw(yamahaPowerRaw, yamahaPowerLen, 38);
    irsend.sendNEC(yamahaSoundbarCode);
    delay(300); // small gap between devices
    
    // Send Insignia TV power
    //irsend.sendRaw(insigniaPowerRaw, sizeof(insigniaPowerRaw)/sizeof(uint16_t), 38);
    irsend.sendNEC(insigniaTvCode);
    
    Serial.println("Done sending!");
  }

  lastButtonState = buttonState;
  delay(50); // simple debounce
}
